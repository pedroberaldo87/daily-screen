PORT=3000
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
ADMIN_EMAILS=you@gmail.com
SESSION_SECRET=change-me-to-random-string
# Pairing key for the wall display (>= 32 random chars, e.g. `openssl rand -hex 32`).
# Open https://<your-domain>/?key=<DISPLAY_KEY> once on the tablet. Empty = no display can be paired.
DISPLAY_KEY=
DATABASE_PATH=./daily-screen.db
WEATHER_LAT=-23.55
WEATHER_LON=-46.63
WEATHER_TZ=America/Sao_Paulo
